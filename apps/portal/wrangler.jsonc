{
  "name": "paibook-portal",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "paibook-media"
    }
  ],
  "routes": [
    { "pattern": "paibook.lssa.fun/*", "zone_name": "lssa.fun" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paibook",
      "database_id": "a8373d8a-10ad-4abb-b2ba-996e988aebf8"
    }
  ]
}
