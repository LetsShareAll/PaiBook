{
  "name": "paibook-portal",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "paibook-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paibook",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
